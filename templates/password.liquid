<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--off-white);">
  <div style="text-align:center;max-width:480px;padding:40px;">
    <div style="margin-bottom:40px;">
      <span style="font-size:20px;font-weight:600;letter-spacing:0.28em;text-transform:uppercase;">Mareno</span><br>
      <span style="font-size:9px;letter-spacing:0.4em;text-transform:uppercase;opacity:0.45;">Label</span>
    </div>
    <h2 style="margin-bottom:16px;">{{ 'general.password_page.login_form_heading' | t }}</h2>
    {%- form 'storefront_password' -%}
      <div style="display:flex;margin-top:32px;">
        <input type="password" name="password" style="flex:1;padding:14px 20px;border:1px solid #111;border-right:none;background:transparent;font-size:14px;outline:none;" placeholder="Password">
        <button type="submit" style="padding:14px 28px;background:#111;color:#F5F5F5;border:none;font-size:11px;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>
