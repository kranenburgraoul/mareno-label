<div class="container" style="padding:80px 40px 120px;">
  <h1 style="font-weight:300;margin-bottom:40px;">Search</h1>

  <form action="{{ routes.search_url }}" method="get" style="display:flex;max-width:560px;margin-bottom:64px;">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Search products..."
      style="flex:1;padding:14px 20px;border:1px solid #111;border-right:none;background:transparent;font-size:14px;outline:none;">
    <button type="submit" style="padding:14px 28px;background:#111;color:#F5F5F5;border:none;font-size:11px;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;">Search</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p style="color:#999;">No results for &ldquo;{{ search.terms }}&rdquo;.</p>
    {%- else -%}
      <p style="font-size:13px;color:#999;margin-bottom:40px;">{{ search.results_count }} results for &ldquo;{{ search.terms }}&rdquo;</p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:32px 24px;">
        {%- for item in search.results -%}
          <a href="{{ item.url }}" style="display:block;text-decoration:none;color:inherit;">
            {%- if item.featured_image -%}
              <img src="{{ item.featured_image | img_url: '400x' }}" alt="{{ item.featured_image.alt | escape }}" style="width:100%;aspect-ratio:3/4;object-fit:cover;margin-bottom:12px;">
            {%- endif -%}
            <p style="font-size:14px;font-weight:500;">{{ item.title }}</p>
            {%- if item.price -%}
              <p style="font-size:14px;color:#666;margin-top:4px;">{{ item.price | money }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
