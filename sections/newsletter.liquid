<section class="newsletter">
  <div class="container">
    <div class="nl-inner reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'nlForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="nl-form">
          <input
            type="email"
            name="contact[email]"
            class="nl-input"
            placeholder="Your email address"
            required
            autocomplete="email">
          <button type="submit" class="nl-btn" id="nlBtn">
            {{ section.settings.button_label | default: 'Sign up' }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p style="color:var(--green);font-size:13px;margin-top:16px;">Thank you for subscribing.</p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}
        <span class="nl-note">{{ section.settings.note }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow",       "default": "Stay connected" },
    { "type": "text",     "id": "heading",      "label": "Heading",       "default": "Join the Mareno List" },
    { "type": "textarea", "id": "subheading",   "label": "Subheading",    "default": "Get early access to new drops, styling tips and exclusive offers. No noise — just quality." },
    { "type": "text",     "id": "button_label", "label": "Button label",  "default": "Sign up" },
    { "type": "text",     "id": "note",         "label": "Privacy note",  "default": "We respect your privacy. Unsubscribe at any time." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
