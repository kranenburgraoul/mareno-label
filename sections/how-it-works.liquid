<section class="how">
  <div class="container">

    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="steps">
      {%- for i in (1..3) -%}
        {%- assign s_heading = section.settings['step_heading_' | append: i] -%}
        {%- assign s_text    = section.settings['step_text_'    | append: i] -%}
        {%- assign s_num     = '0' | append: i -%}
        <div class="step reveal">
          <span class="step-n">{{ s_num }}</span>
          <div class="step-bar"></div>
          <h3>{{ s_heading }}</h3>
          <p>{{ s_text }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",    "default": "The approach" },
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "How to Build Your Effortless Wardrobe" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Three simple steps to looking sharp without overthinking it." },
    { "type": "header",   "content": "Step 1" },
    { "type": "text",     "id": "step_heading_1", "label": "Step 1 heading", "default": "Choose Your Essentials" },
    { "type": "textarea", "id": "step_text_1",    "label": "Step 1 text",    "default": "Start with clean, versatile pieces that work across multiple outfits. A linen shirt, a fitted chino, a quality loafer — these are your foundations." },
    { "type": "header",   "content": "Step 2" },
    { "type": "text",     "id": "step_heading_2", "label": "Step 2 heading", "default": "Build Complete Looks" },
    { "type": "textarea", "id": "step_text_2",    "label": "Step 2 text",    "default": "Combine shirts, trousers and loafers without second-guessing yourself. Our pieces are designed to complement each other naturally." },
    { "type": "header",   "content": "Step 3" },
    { "type": "text",     "id": "step_heading_3", "label": "Step 3 heading", "default": "Wear Anywhere" },
    { "type": "textarea", "id": "step_text_3",    "label": "Step 3 text",    "default": "From city days to summer evenings and weekend travel — the same pieces, multiple settings, always appropriate and comfortable." }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
