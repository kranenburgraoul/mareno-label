<section class="how">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" {{ block.shopify_attributes }}>
          <span class="step-n">0{{ forloop.index }}</span>
          <div class="step-bar"></div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",    "default": "The approach" },
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "How to Build Your Effortless Wardrobe" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Three simple steps to looking sharp without overthinking it." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text",     "id": "heading", "label": "Step heading", "default": "Step title" },
        { "type": "textarea", "id": "text",    "label": "Step text",    "default": "Describe this step." }
      ]
    }
  ],
  "presets": [{
    "name": "How It Works",
    "blocks": [
      { "type": "step", "settings": { "heading": "Choose Your Essentials",  "text": "Start with clean, versatile pieces that work across multiple outfits. A linen shirt, a fitted chino, a quality loafer — these are your foundations." } },
      { "type": "step", "settings": { "heading": "Build Complete Looks",    "text": "Combine shirts, trousers and loafers without second-guessing yourself. Our pieces are designed to complement each other naturally." } },
      { "type": "step", "settings": { "heading": "Wear Anywhere",           "text": "From city days to summer evenings and weekend travel — the same pieces, multiple settings, always appropriate and comfortable." } }
    ]
  }]
}
{% endschema %}
