<section class="bundles">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="bundles-grid">
      {%- for block in section.blocks -%}
        <div class="bundle-card reveal" {{ block.shopify_attributes }}>
          <span class="bundle-num">0{{ forloop.index }}</span>
          <h3 class="bundle-name">{{ block.settings.name }}</h3>
          <p class="bundle-items">{{ block.settings.items | newline_to_br }}</p>
          <div class="bundle-price-row">
            <span class="bundle-price">{{ block.settings.price }}</span>
            {%- if block.settings.save != blank -%}
              <span class="bundle-save">{{ block.settings.save }}</span>
            {%- endif -%}
          </div>
          <a href="{{ block.settings.url | default: '#' }}" class="btn btn-primary">Shop Bundle</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "settings": [
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",    "default": "Curated looks" },
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "Complete the Look" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Carefully considered combinations that take the guesswork out of dressing well." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "text",     "id": "name",  "label": "Bundle name",  "default": "Summer Set" },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "Linen Shirt\nLightweight Chino" },
        { "type": "text",     "id": "price", "label": "Price",        "default": "€169" },
        { "type": "text",     "id": "save",  "label": "Save badge",   "default": "Save €19" },
        { "type": "url",      "id": "url",   "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Bundles",
    "blocks": [
      { "type": "bundle", "settings": { "name": "Summer Set",       "items": "Linen Shirt\nLightweight Chino",              "price": "€169", "save": "Save €19" } },
      { "type": "bundle", "settings": { "name": "Smart Casual Set", "items": "Short Sleeve Polo\nChino\nSummer Loafer",     "price": "€299", "save": "Save €28" } },
      { "type": "bundle", "settings": { "name": "Weekend Set",      "items": "Linen Shirt\nSummer Loafer",                  "price": "€219", "save": "Save €19" } }
    ]
  }]
}
{% endschema %}
