<section class="about" id="about">
  <div class="container">
    <div class="about-grid">

      <div class="about-visual reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | img_url: '800x' }}" alt="{{ section.settings.image.alt | default: 'About Mareno Label' }}" loading="lazy">
        {%- endif -%}
      </div>

      <div class="about-content reveal">
        <span class="eyebrow" style="justify-content:flex-start;">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text_1 != blank -%}
          <p>{{ section.settings.text_1 }}</p>
        {%- endif -%}
        {%- if section.settings.text_2 != blank -%}
          <p>{{ section.settings.text_2 }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/about' }}" class="btn btn-primary">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Brand",
  "settings": [
    { "type": "text",         "id": "eyebrow",   "label": "Eyebrow",        "default": "The brand" },
    { "type": "text",         "id": "heading",   "label": "Heading",        "default": "Minimal menswear, made effortless." },
    { "type": "textarea",     "id": "text_1",    "label": "Paragraph 1",    "default": "Mareno Label creates refined wardrobe essentials for men who value simplicity, comfort and style. Every piece is designed to be easy to wear, easy to combine and suitable for everyday life, travel and smart casual moments." },
    { "type": "textarea",     "id": "text_2",    "label": "Paragraph 2",    "default": "We believe looking good should never feel complicated. That's why every detail — the cut, the fabric, the colour — is considered from the perspective of the modern man." },
    { "type": "image_picker", "id": "image",     "label": "Image" },
    { "type": "text",         "id": "cta_label", "label": "CTA label",      "default": "About Mareno Label" },
    { "type": "url",          "id": "cta_url",   "label": "CTA link" }
  ],
  "presets": [{ "name": "About Brand" }]
}
{% endschema %}
