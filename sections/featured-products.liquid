<section class="featured" id="featured">
  <div class="container">

    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="products-grid">
      {%- if section.settings.collection != blank -%}
        {%- assign feat_collection = collections[section.settings.collection] -%}
        {%- for product in feat_collection.products limit: 4 -%}
          <article class="product-card reveal">
            <div class="pcard-img">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | img_url: '600x800', crop: 'center' }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy">
              {%- else -%}
                <div class="pcard-bg p{{ forloop.index }}">
                  <span class="pcard-name-bg">{{ product.title }}</span>
                </div>
              {%- endif -%}
              {%- if product.tags contains 'best-seller' -%}
                <span class="pcard-badge">Best Seller</span>
              {%- elsif product.tags contains 'new' -%}
                <span class="pcard-badge">New</span>
              {%- endif -%}
              <div class="pcard-overlay">
                <button class="quick-add" data-variant-id="{{ product.first_available_variant.id }}">Add to Cart</button>
              </div>
            </div>
            <div class="pcard-body">
              <a href="{{ product.url }}"><h3 class="pcard-title">{{ product.title }}</h3></a>
              <p class="pcard-desc">{{ product.metafields.custom.short_description | default: product.type }}</p>
              <div class="pcard-foot">
                <span class="pcard-price">{{ product.price | money }}</span>
                <div class="pcard-colors">
                  {%- for variant in product.variants limit: 4 -%}
                    {%- if variant.option1 contains '#' -%}
                      <span class="cdot" style="background:{{ variant.option1 }};" title="{{ variant.option1 }}"></span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign placeholder_products = 'Linen Shirt,Short Sleeve Polo,Lightweight Chino,Summer Loafer' | split: ',' -%}
        {%- assign placeholder_prices = '€89,€79,€99,€149' | split: ',' -%}
        {%- assign placeholder_descs = 'Breathable linen · relaxed fit|Pique cotton · modern cut|Slim tapered · wrinkle-free|Italian suede · cushioned sole' | split: '|' -%}
        {%- assign placeholder_badges = 'Best Seller,New,,New' | split: ',' -%}
        {%- for name in placeholder_products -%}
          <article class="product-card reveal">
            <div class="pcard-img">
              <div class="pcard-bg p{{ forloop.index }}">
                <span class="pcard-name-bg">{{ name }}</span>
              </div>
              {%- if placeholder_badges[forloop.index0] != blank -%}
                <span class="pcard-badge">{{ placeholder_badges[forloop.index0] }}</span>
              {%- endif -%}
              <div class="pcard-overlay">
                <button class="quick-add">Add to Cart</button>
              </div>
            </div>
            <div class="pcard-body">
              <h3 class="pcard-title">{{ name }}</h3>
              <p class="pcard-desc">{{ placeholder_descs[forloop.index0] }}</p>
              <div class="pcard-foot">
                <span class="pcard-price">{{ placeholder_prices[forloop.index0] }}</span>
                <div class="pcard-colors">
                  <span class="cdot" style="background:#F5F5F5;"></span>
                  <span class="cdot" style="background:#D6CFC7;"></span>
                  <span class="cdot" style="background:#2F3E34;"></span>
                </div>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text",       "id": "eyebrow",    "label": "Eyebrow",    "default": "Curated selection" },
    { "type": "text",       "id": "heading",    "label": "Heading",    "default": "Summer Essentials" },
    { "type": "textarea",   "id": "subheading", "label": "Subheading", "default": "Clean pieces designed to carry you from morning meetings to summer evenings without a second thought." },
    { "type": "collection", "id": "collection", "label": "Collection to display" }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
