<header class="site-header" id="siteHeader">
  <div class="hdr-inner">

    <a href="{{ routes.root_url }}" class="site-logo">
      <span class="logo-a">{{ section.settings.logo_main | default: 'Mareno' }}</span>
      <span class="logo-b">{{ section.settings.logo_sub | default: 'Label' }}</span>
    </a>

    <nav class="hdr-nav" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="/collections/all">Shop</a>
        <a href="/pages/about">About</a>
        <a href="/pages/contact">Contact</a>
        <a href="/pages/order-tracking">Track order</a>
      {%- endfor -%}
    </nav>

    <div class="hdr-actions">
      <a href="{{ routes.cart_url }}" class="cart-btn" aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<div class="mob-menu" id="mobMenu" aria-hidden="true">
  <button class="mob-close" id="mobClose" aria-label="Close menu">&#10005;</button>
  <a href="{{ routes.root_url }}" class="site-logo" style="margin-bottom:48px;">
    <span class="logo-a">{{ section.settings.logo_main | default: 'Mareno' }}</span>
    <span class="logo-b">{{ section.settings.logo_sub | default: 'Label' }}</span>
  </a>
  <nav class="mob-nav">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- else -%}
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/collections/all">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/order-tracking">Track order</a>
    {%- endfor -%}
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text",      "id": "logo_main", "label": "Logo — main word", "default": "Mareno" },
    { "type": "text",      "id": "logo_sub",  "label": "Logo — sub word",  "default": "Label" },
    { "type": "link_list", "id": "menu",      "label": "Navigation menu",  "default": "main-menu" }
  ]
}
{% endschema %}
