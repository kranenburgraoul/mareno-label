<div class="ann-bar" role="banner">
  <div class="ann-track">
    {%- for block in section.blocks -%}
      <div class="ann-item" {{ block.shopify_attributes }}>{{ block.settings.message }}</div>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <div class="ann-item" {{ block.shopify_attributes }}>{{ block.settings.message }}</div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "message", "label": "Message", "default": "Free shipping from €100 · Easy returns within 14 days" }
      ]
    }
  ],
  "presets": [{
    "name": "Announcement Bar",
    "blocks": [
      { "type": "message", "settings": { "message": "Free shipping from €100 · Easy returns within 14 days" } },
      { "type": "message", "settings": { "message": "New summer essentials — now available" } },
      { "type": "message", "settings": { "message": "Designed in Europe · Shipped worldwide" } }
    ]
  }]
}
{% endschema %}
