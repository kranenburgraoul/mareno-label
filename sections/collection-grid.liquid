<section class="cats-section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="cats-grid">
      {%- for block in section.blocks -%}
        <div class="cat-card reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="cat-img" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            <div class="cat-visual cat-c{{ forloop.index }}"></div>
          {%- endif -%}
          <div class="cat-info">
            <h3>{{ block.settings.title }}</h3>
            <a href="{{ block.settings.url | default: '#' }}" class="cat-link">View Collection</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading",  "default": "The Collection" }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text",         "id": "title",  "label": "Title",       "default": "Category" },
        { "type": "image_picker", "id": "image",  "label": "Image" },
        { "type": "url",          "id": "url",    "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Collection Grid",
    "blocks": [
      { "type": "category", "settings": { "title": "Shirts" } },
      { "type": "category", "settings": { "title": "Polos" } },
      { "type": "category", "settings": { "title": "Trousers" } },
      { "type": "category", "settings": { "title": "Loafers" } }
    ]
  }]
}
{% endschema %}
